# 北名大小助手 · 环境变量示例
# ⛔ 本文件只允许出现键名与占位符，任何真实密钥都不许写进来。
# 用法：复制为 .env 后填本地值；.env 已被 .gitignore 忽略。

SITE_DOMAIN=demo.knowingly.dpdns.org
PORT=3000
DEMO_TOKEN=replace_me
TILE_PROVIDER_KEY=replace_me
DB_PATH=./data/beimingda.db

# ---- 可选：LLM 侧能力（M1 截图理解 / M2 画像抽取与语义判定需要） ----
# 保持为空则走规则化兜底实现，功能不阻塞、精度下降。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
